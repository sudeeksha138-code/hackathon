# Fake Social Media Account Detector AI - Environment Variables
# Copy this file to .env and configure your keys if available.

# 1. X (formerly Twitter) API v2 Bearer Token
# Supports public user lookup via GET /2/users/by/username/:username
X_BEARER_TOKEN=

# 2. Instagram Graph API Access Token (requires approved Meta app & permissions)
INSTAGRAM_ACCESS_TOKEN=

# 3. Facebook Graph API Access Token (for public pages)
FACEBOOK_ACCESS_TOKEN=

# Optional: Server Port (defaults to 5000)
PORT=5000

